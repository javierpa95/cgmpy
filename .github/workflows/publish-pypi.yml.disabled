# ==========================================
# PUBLISH TO PYPI — CURRENTLY DISABLED
# ==========================================
# This workflow is renamed to .disabled so GitHub Actions will not pick
# it up. The project is in a pre-release phase (v0.5.0) and the
# maintainer wants to hold off on publishing to PyPI until they are
# happy with the package.
#
# TO RE-ENABLE:
#   1. git mv .github/workflows/publish-pypi.yml.disabled \
#           .github/workflows/publish-pypi.yml
#   2. Configure PyPI Trusted Publishing (OIDC) at
#      https://pypi.org/manage/account/publishing/
#   3. Verify the workflow_dispatch input and the environment name
#      match the configuration above.
#   4. Trigger the workflow manually from the Actions tab.
# ==========================================

name: Publish to PyPI

# Manual trigger only. Per the project's security posture, publishing
# to PyPI is gated on a human pressing the button after the release PR
# has been reviewed and merged.

on:
  workflow_dispatch:
    inputs:
      tag:
        description: "Git tag to publish (e.g., v0.4.0)"
        required: true
        type: string
      repository:
        description: "PyPI repository (pypi or testpypi)"
        required: false
        default: pypi
        type: choice
        options:
          - pypi
          - testpypi

permissions:
  contents: read
  id-token: write  # for PyPI trusted publishing (OIDC)

jobs:
  publish:
    name: Build & publish to PyPI
    runs-on: ubuntu-latest
    environment: pypi
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          ref: ${{ inputs.tag }}
          fetch-depth: 0

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install build tooling
        run: |
          python -m pip install --upgrade pip
          pip install build twine

      - name: Build sdist + wheel
        run: python -m build

      - name: Validate metadata
        run: twine check dist/*

      - name: Display built artifacts
        run: ls -la dist/

      - name: Publish to TestPyPI
        if: inputs.repository == 'testpypi'
        uses: pypa/gh-action-pypi-publish@release/v1
        with:
          repository-url: https://test.pypi.org/legacy/

      - name: Publish to PyPI
        if: inputs.repository == 'pypi'
        uses: pypa/gh-action-pypi-publish@release/v1
