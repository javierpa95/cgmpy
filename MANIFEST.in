# MANIFEST.in — sdist contents for CGMPy
#
# This file is used by setuptools (via PEP 517/518) to decide which
# non-Python files are bundled into the source distribution. The wheel
# is built directly from the Python packages, so this file only affects
# `python -m build --sdist` (and `pip download cgmpy --no-binary`).

# --- Top-level files ----------------------------------------------------

include LICENSE
include README.md
include CHANGELOG.md
include ROADMAP.md
include CONTRIBUTING.md
include CODE_OF_CONDUCT.md
include SECURITY.md
include AGENTS.md
include mkdocs.yml
include .editorconfig
include .gitattributes
include .gitignore
include pyproject.toml
include commitlint.config.cjs
include Makefile

# --- Examples, tests, scripts, docs, agent harness ----------------------

recursive-include examples *.py
recursive-include examples *.md
recursive-include examples *.txt

recursive-include tests *.py
recursive-include tests *.csv
recursive-include tests *.json
recursive-include tests/conftest.py

recursive-include scripts *.py
recursive-include scripts *.sh
recursive-include scripts *.ps1
recursive-include scripts *.cjs
recursive-include scripts *.md

recursive-include docs *.md
recursive-include docs *.yml
recursive-include docs *.yaml
recursive-include docs *.css
recursive-include docs *.js

recursive-include .opencode *.md
recursive-include .opencode *.jsonc
recursive-include .opencode *.json
recursive-include .github *.md
recursive-include .github *.yml
recursive-include .github *.yaml

# --- Generated build/test artifacts to exclude ---------------------------

global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.egg-info
global-exclude *.so
global-exclude .DS_Store
global-exclude .pytest_cache
global-exclude .ruff_cache
global-exclude .mypy_cache
global-exclude .coverage
global-exclude htmlcov
global-exclude build
global-exclude dist
global-exclude .venv
global-exclude venv
global-exclude node_modules
global-exclude *.lock
global-exclude *~
